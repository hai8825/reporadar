# Copy to .env.production.local (gitignored) to run migrations against PROD.
#   npm run db:deploy:prod
#
# This file holds ONLY what the Prisma CLI needs to migrate production — it is
# never read by the app at runtime (Vercel injects the app's env vars).
#
# Use the DIRECT / unpooled Neon endpoint here, NOT the pooled one: migrations
# need a real session connection (advisory locks + DDL), which PgBouncer breaks.
# Get it from console.neon.tech -> reporadar -> Branches -> production -> the
# connection string WITHOUT "-pooler" in the host.
DATABASE_URL=
