# Copy to .env.local and fill in.
# Create the OAuth app at https://github.com/settings/developers
#   Homepage URL:        http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github

NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Neon Postgres — connection string for the branch you're working against.
# Get it from console.neon.tech → reporadar → Branches → <branch>.
# Prisma 7 uses this single URL for both migrations and the runtime client,
# so in development use the DIRECT (unpooled) endpoint — migrations need it.
# For production, point the app at the POOLED endpoint and run
# `prisma migrate deploy` against the direct one.
DATABASE_URL=

# Optional — only for `npm run codegen`, which introspects GitHub's live schema
# to regenerate gql/. Running or building the app never reads this, because the
# generated output is committed.
# Any personal access token works; introspection requires no scopes.
# Quickest source: `gh auth token`.
GITHUB_TOKEN_CODEGEN=
